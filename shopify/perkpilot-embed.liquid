{% comment %}
  Manual install of the PerkPilot assistant, for stores that don't use the theme app extension
  (the extension is the recommended path: Online Store > Themes > Customize > App embeds > PerkPilot assistant).
  Install: Online Store > Themes > Customize > Footer > Add section > "Custom Liquid", paste this file, and set the
  URL below to your PerkPilot app (no trailing slash). It loads the same script the extension uses.
{% endcomment %}
{%- assign perkpilot_url = "https://YOUR-PERKPILOT-APP" -%}
<div id="perkpilot-root" hidden
  data-app-url="{{ perkpilot_url }}"
  data-shop="{{ shop.permanent_domain }}"
  data-store-name="{{ shop.name | escape }}"
  data-label="Shopping assistant"
  data-signed-in="{% if customer %}1{% endif %}"
  {% if product %}data-product-id="{{ product.id }}" data-product-title="{{ product.title | escape }}"{% endif %}></div>
<link rel="stylesheet" href="{{ perkpilot_url }}/perkpilot-embed.css">
<script src="{{ perkpilot_url }}/perkpilot-embed.js" defer></script>
