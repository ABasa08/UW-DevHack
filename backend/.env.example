# Copy to backend/.env. Every value is optional.

# Live Gemini interpretation. Without a key the app uses the deterministic fallback
# interpreter and labels it as such in the UI.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite
# Reasoning depth for models that support it (low keeps responses around 1-3s). Blank = model default.
GEMINI_THINKING_LEVEL=low
# auto = use Gemini when a key is present; fallback = always use the rule-based interpreter
PERKPILOT_AI_MODE=auto

# MongoDB persistence. Leave empty to use the local JSON-file fallback (backend/data/demo_state.json).
MONGODB_URI=
MONGODB_DB=perkpilot

# shopify = your Shopify store is the commerce platform: Shopify-calculated totals, draft-order checkout, orders,
#           refunds, exchanges and fulfillment through the Admin API (see README). Needs the SHOPIFY_* values below.
# demo (default) = the fictional fixture store used by tests and evaluation; payments/refunds/shipping simulated.
# live = advisory only: real clock, no seeding, no commerce effects, MongoDB required (no file fallback).
PERKPILOT_MODE=demo
# shopify mode: the store's display name (default: the name Shopify reports).
PERKPILOT_STORE_NAME=
# Signs shopper session tokens. Defaults to a key derived from SHOPIFY_CLIENT_SECRET.
PERKPILOT_SESSION_SECRET=
# Bearer token for the merchant console outside Shopify admin (inside it, App Bridge session tokens are used).
# Protects /api/admin/* in every mode, and /api/merchant/* + /api/eval/* in live and shopify modes.
PERKPILOT_ADMIN_TOKEN=
# live only: comma-separated CORS origins.
PERKPILOT_ALLOWED_ORIGINS=

# Shopify app (Dev Dashboard). Scopes come from shopify.app.toml (`npx shopify app deploy` from the repo root).
SHOPIFY_SHOP=your-store.myshopify.com
# Dev Dashboard app credentials (client credentials grant)...
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
# ...or an existing Admin API access token (shpat_...) from a legacy custom app. Takes precedence if set.
SHOPIFY_ADMIN_TOKEN=
SHOPIFY_API_VERSION=2026-10
SHOPIFY_SIZE_OPTION=Size
SHOPIFY_COLOR_OPTION=Color
# Live store data on the merchant dashboard: Shopify sends webhooks to <this URL>/api/shopify/webhooks.
# Must be the app's public HTTPS address (a deployment, or an ngrok tunnel to port 3000).
PERKPILOT_PUBLIC_URL=
